# Copy to .env.local and fill in real values. Nothing here is safe to ship
# to the browser - there's no NEXT_PUBLIC_ prefix on anything, since this
# project has no client Firebase SDK and the Hive key must never reach a
# browser.

# Read by the Firebase Admin SDK. Use "demo-pixeltruth" for local dev
# against the emulator (see firebase.json / .firebaserc); the real project
# ID only matters in production, where Cloud Run's attached service account
# authenticates via Application Default Credentials.
FIREBASE_PROJECT_ID=demo-pixeltruth

# Local dev only - points the Admin SDK at the emulator instead of the live
# project. Not needed in production.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Hive Moderation API key (server-side only, see src/lib/detection/hive.ts).
# Real calls cost money even at low volume - budget for a small amount of
# spend during dev/testing.
HIVE_API_KEY=
